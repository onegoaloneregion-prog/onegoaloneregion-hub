  <script>
    // Tab switching logic
    function switchTab(tabId) {
      document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
      document.querySelectorAll('.tab-btn').forEach(btn => btn.classList.remove('tab-active'));
      
      const targetTab = document.getElementById('tab-' + tabId);
      const targetBtn = document.getElementById('tab-btn-' + tabId);
      
      if (targetTab) targetTab.classList.remove('hidden');
      if (targetBtn) targetBtn.classList.add('tab-active');
      
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    // Filter benefits in Tab 2
    function filterBenefit(cat) {
      const groups = document.querySelectorAll('.benefit-group');
      const buttons = document.querySelectorAll('.filter-btn');
      
      buttons.forEach(b => {
        b.classList.remove('bg-fwd-orange', 'text-white');
        b.classList.add('bg-slate-100', 'text-slate-600');
      });
      
      const activeBtn = document.getElementById('btn-filter-' + cat);
      if (activeBtn) {
        activeBtn.classList.remove('bg-slate-100', 'text-slate-600');
        activeBtn.classList.add('bg-fwd-orange', 'text-white');
      }

      if (cat === 'all') {
        groups.forEach(g => g.classList.remove('hidden'));
      } else {
        groups.forEach(g => {
          if (g.classList.contains(cat)) {
            g.classList.remove('hidden');
          } else {
            g.classList.add('hidden');
          }
        });
      }
