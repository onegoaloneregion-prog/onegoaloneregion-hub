    let currentGender = 'male';

    function setGender(g) {
      currentGender = g;
      const maleBtn = document.getElementById('btn-gender-male');
      const femaleBtn = document.getElementById('btn-gender-female');
      
      if (g === 'male') {
        maleBtn.className = "gender-btn py-2.5 px-4 rounded-xl text-xs font-bold border border-orange-500 bg-fwd-orange text-white flex items-center justify-center gap-2 transition-all";
        femaleBtn.className = "gender-btn py-2.5 px-4 rounded-xl text-xs font-bold border border-slate-300 bg-white text-slate-700 hover:bg-slate-100 flex items-center justify-center gap-2 transition-all";
      } else {
        femaleBtn.className = "gender-btn py-2.5 px-4 rounded-xl text-xs font-bold border border-orange-500 bg-fwd-orange text-white flex items-center justify-center gap-2 transition-all";
        maleBtn.className = "gender-btn py-2.5 px-4 rounded-xl text-xs font-bold border border-slate-300 bg-white text-slate-700 hover:bg-slate-100 flex items-center justify-center gap-2 transition-all";
      }
      calculatePremium();
    }

    function calculatePremium() {
      let age = parseInt(document.getElementById('input-age').value) || 30;
      if (age < 1) age = 1;
      if (age > 80) age = 80;

      const mode = document.getElementById('input-mode').value;
      const hasChildRider = document.getElementById('input-child-rider').checked;
      const personalNcd = parseFloat(document.getElementById('input-ncd-personal').value) || 0;
      const familyNcd = parseFloat(document.getElementById('input-ncd-family').value) || 0;

      // Base annual premium lookup
      const rateTable = currentGender === 'male' ? MALE_PREMIUMS_ANNUAL : FEMALE_PREMIUMS_ANNUAL;
      let baseAnnual = rateTable[age] || rateTable[30];

      // Calculate child rider premium
      let riderAnnual = 0;
      const rowChildRider = document.getElementById('row-child-rider');
      if (hasChildRider) {
        rowChildRider.style.display = 'flex';
        if (age >= 19 && age <= 56) {
          riderAnnual = CHILD_RIDER_PREMIUMS[age] || 1082;
          document.getElementById('res-child-premium').textContent = 'HK$ ' + (mode === 'monthly' ? (riderAnnual * 0.09).toFixed(2) : riderAnnual.toLocaleString());
        } else {
          document.getElementById('res-child-premium').textContent = '不適用 (受保人須為19-56歲)';
        }
      } else {
        rowChildRider.style.display = 'none';
      }

      // Discount calculations (applies ONLY to basic plan premium)
      const totalDiscountPct = personalNcd + familyNcd;
      const discountAmountAnnual = baseAnnual * (totalDiscountPct / 100);
      const discountedBaseAnnual = baseAnnual - discountAmountAnnual;

      // Final premium based on payment mode (Monthly factor is 0.09)
      let finalPayable = 0;
      let displayBase = 0;
      let displayDiscountVal = 0;

      if (mode === 'monthly') {
        const monthlyBase = (baseAnnual * 0.09);
        const monthlyDiscount = (discountAmountAnnual * 0.09);
        const monthlyChild = (riderAnnual * 0.09);
        
        displayBase = monthlyBase.toFixed(2);
        displayDiscountVal = monthlyDiscount.toFixed(2);
        finalPayable = (monthlyBase - monthlyDiscount + (hasChildRider && age >= 19 && age <= 56 ? monthlyChild : 0)).toFixed(2);
        
        document.getElementById('res-period-unit').textContent = '/ 每月 (0.09倍數)';
      } else {
        displayBase = baseAnnual.toLocaleString();
        displayDiscountVal = Math.round(discountAmountAnnual).toLocaleString();
        finalPayable = Math.round(discountedBaseAnnual + (hasChildRider && age >= 19 && age <= 56 ? riderAnnual : 0)).toLocaleString();
        
        document.getElementById('res-period-unit').textContent = '/ 每年';
      }

      // Update UI elements
      document.getElementById('display-profile').textContent = `${currentGender === 'male' ? '男性' : '女性'} ${age}歲 • ${mode === 'monthly' ? '月繳' : '年繳'}`;
      document.getElementById('res-base-premium').textContent = 'HK$ ' + displayBase;
      document.getElementById('res-discount-pct').textContent = `${totalDiscountPct}% (個人 ${personalNcd}% + 家庭 ${familyNcd}%)`;
      document.getElementById('res-discount-val').textContent = '- HK$ ' + displayDiscountVal;
      document.getElementById('res-final-premium').textContent = 'HK$ ' + finalPayable;
    }

    // Initialize calculation on page load
    window.onload = function() {
      calculatePremium();
    }
