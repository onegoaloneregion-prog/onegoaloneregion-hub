    };

    // Child Rider (HVI3) Premium based on Insured Parent's Next Birthday Age (Ages 19-56 eligible)
    const CHILD_RIDER_PREMIUMS = {
      19: 751, 20: 765, 21: 771, 22: 767, 23: 759, 24: 774, 25: 836, 26: 884, 27: 933, 28: 984, 29: 1033,
